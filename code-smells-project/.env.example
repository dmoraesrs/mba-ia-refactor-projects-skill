# Copie para .env (ou exporte no shell) e preencha. Nunca versione valores reais.

# Segredo do Flask. Sem ele, um valor aleatório é gerado a cada boot (só para desenvolvimento).
SECRET_KEY=

# Token exigido no header X-Admin-Token pelas rotas /admin/*. Vazio = rotas administrativas bloqueadas.
ADMIN_TOKEN=

# Senhas dos usuários de exemplo criados no primeiro boot (banco vazio).
# Sem elas, senhas aleatórias são usadas e os usuários de exemplo não conseguem fazer login.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
APP_ENV=producao
LOG_LEVEL=INFO

# Banco SQLite (arquivo)
DATABASE_PATH=loja.db

# Origens CORS permitidas, separadas por vírgula (padrão: *)
CORS_ORIGINS=
