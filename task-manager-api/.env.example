# Copie para .env (na raiz deste projeto) ou exporte no shell. Nunca versione valores reais.

# Chave do Flask, também usada para assinar os tokens de login.
# Sem ela, um valor aleatório é gerado a cada boot (só para desenvolvimento; tokens deixam de valer ao reiniciar).
SECRET_KEY=

# Validade do token de login, em segundos (padrão: 8 horas)
TOKEN_MAX_AGE=28800

# Senha dos usuários de exemplo criados pelo seed.py. Sem ela, uma senha aleatória é gerada e exibida no log.
SEED_PASSWORD=

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Banco (URI SQLAlchemy). sqlite:///tasks.db grava em instance/tasks.db
DATABASE_URL=sqlite:///tasks.db

# Origens CORS permitidas, separadas por vírgula (padrão: *)
CORS_ORIGINS=

# SMTP para notificação de task atribuída. Sem SMTP_HOST/SMTP_USER/SMTP_PASSWORD, as notificações só vão para o log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
