# Porta HTTP (padrão 3000)
PORT=3000
# Caminho do banco SQLite (padrão :memory:, recriado com seed a cada boot)
DB_PATH=:memory:
# Chave do gateway de pagamento (nunca commitar o valor real)
PAYMENT_GATEWAY_KEY=
# Token exigido nas rotas administrativas: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=
# Nível de log: debug | info | warn | error | silent
LOG_LEVEL=info
